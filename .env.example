# ==============================================================================
# Google Cloud / Gemini API Production Configuration (Server-Side Only)
# ==============================================================================

# GEMINI_API_KEY: Required for production AI journal reflections.
# NEVER expose this key in frontend JavaScript, React components, or VITE_* variables.
GEMINI_API_KEY="your_gemini_api_key_here"

# GEMINI_MODEL: Optional model selector (defaults to "gemini-3.8-flash")
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The public URL where this app is hosted (e.g. Cloud Run, Vercel, or local)
APP_URL="http://localhost:3000"

